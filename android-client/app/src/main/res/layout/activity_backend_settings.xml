<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_settings"
                android:textColor="@color/brand_navy"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:lineSpacingExtra="3dp"
            android:text="@string/server_settings_subtitle"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/space_l">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_address_label"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/backend_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_input"
                android:hint="@string/server_address_hint"
                android:inputType="textUri"
                android:padding="@dimen/space_l"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="@dimen/text_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/quick_fill"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_emulator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_m"
                    android:minHeight="@dimen/touch_target"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_chip"
                    android:paddingLeft="@dimen/space_l"
                    android:paddingRight="@dimen/space_l"
                    android:text="@string/chip_emulator"
                    android:textColor="@color/brand_blue_dark"
                    android:textSize="@dimen/text_secondary" />

                <TextView
                    android:id="@+id/chip_lan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_chip"
                    android:paddingLeft="@dimen/space_l"
                    android:paddingRight="@dimen/space_l"
                    android:text="@string/chip_lan"
                    android:textColor="@color/brand_blue_dark"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:lineSpacingExtra="3dp"
            android:text="@string/server_address_help"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:minHeight="@dimen/button_height"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null"
            android:text="@string/save_and_connect"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_subheading"
            android:textStyle="bold" />

        <Button
            android:id="@+id/cancel_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:minHeight="@dimen/button_height"
            android:background="@drawable/bg_button_secondary"
            android:stateListAnimator="@null"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/brand_blue"
            android:textSize="@dimen/text_subheading"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
