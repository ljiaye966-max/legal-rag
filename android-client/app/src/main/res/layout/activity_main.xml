<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶部工具栏（品牌深蓝） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/brand_navy">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s">

            <View
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_appbar_title"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/refresh"
                android:src="@drawable/ic_refresh"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/server_settings"
                android:src="@drawable/ic_settings"
                android:tint="@android:color/white" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/page_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_height"
            android:max="100"
            android:progressTint="@color/brand_blue_bright"
            android:progressBackgroundTint="@color/brand_navy_soft"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 连接错误页 -->
        <LinearLayout
            android:id="@+id/error_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_xxxl"
            android:background="@color/bg"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle"
                android:padding="18dp"
                android:contentDescription="@string/connection_failed"
                android:src="@drawable/ic_alert"
                android:tint="@color/brand_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:text="@string/connection_failed"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_heading"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/error_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/connection_help"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_secondary" />

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxxl"
                android:minWidth="@dimen/button_min_width"
                android:minHeight="@dimen/button_height"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null"
                android:text="@string/retry"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_subheading"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_open_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:minWidth="@dimen/button_min_width"
                android:minHeight="@dimen/button_height"
                android:background="@drawable/bg_button_secondary"
                android:stateListAnimator="@null"
                android:text="@string/server_settings"
                android:textAllCaps="false"
                android:textColor="@color/brand_blue"
                android:textSize="@dimen/text_subheading"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
