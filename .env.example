SECRET_KEY=change-this-secret
DB_TYPE=sqlite
DATABASE_PATH=storage/legal_rag.db
CHROMA_PATH=storage/chroma
CHROMA_COLLECTION=legal_knowledge

# MySQL 本地数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=请改成你的MySQL密码
MYSQL_DATABASE=legal_rag

# 通义千问配置
USE_LLM=false
CHAT_MODEL_NAME=qwen-plus
EMBEDDING_MODEL_NAME=text-embedding-v4
USE_DASHSCOPE_EMBEDDING=false
# DASHSCOPE_API_KEY=你的API_KEY
# 如使用国际站或专用网关，可填写对应 DashScope API 地址；默认留空。
# DASHSCOPE_BASE_HTTP_API_URL=
DASHSCOPE_TIMEOUT=30

# 手机验证码注册配置。local 模式仅用于本地演示，会在接口响应中返回验证码。
# 生产环境使用阿里云号码认证服务时设为 aliyun_sms_verify。
SMS_PROVIDER=local
SMS_CODE_TTL_SECONDS=300
SMS_CODE_COOLDOWN_SECONDS=60

# 阿里云号码认证（短信认证服务）配置。AccessKey 必须仅保存在后端 .env 文件中。
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# 控制台“短信认证服务”当前提供的签名和模板请填在下面两项。
# ALIYUN_SMS_VERIFY_SIGN_NAME=恒创联众
# ALIYUN_SMS_VERIFY_TEMPLATE_CODE=100001
ALIYUN_SMS_VERIFY_ENDPOINT=dypnsapi.aliyuncs.com
# ALIYUN_SMS_VERIFY_SCHEME_NAME=

# 检索配置
TOP_K=6
KEYWORD_WEIGHT=0.35
VECTOR_WEIGHT=0.65
# 小助手仅使用达到该分数的检索材料，低相关结果会直接提示证据不足。
ASSISTANT_MIN_RELEVANCE_SCORE=0.24
