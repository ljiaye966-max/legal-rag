<view class="page">
  <view class="card">
    <text class="title">类案对比</text>
    <text class="subtitle">选择 2 到 5 个相似案例，查看事实、争点、说理和结果差异。</text>
    <checkbox-group bindchange="chooseCases">
      <label wx:for="{{candidates}}" wx:key="document_id" class="choice">
        <checkbox value="{{item.document_id}}" checked="{{item.checked}}" />
        <view>
          <text class="item-title">{{item.title}}</text>
          <text class="muted">{{item.case_cause}} · {{item.region}} · {{item.year}} · 相关度 {{item.relevance_score}}</text>
        </view>
      </label>
    </checkbox-group>
    <button class="primary-btn" bindtap="compare">生成对比</button>
  </view>

  <view class="card">
    <text class="section-title">对比结果</text>
    <view wx:for="{{cases}}" wx:key="id" class="list-item" data-id="{{item.id}}" bindtap="goDocument">
      <text class="item-title">{{item.title}}</text>
      <text class="muted">{{item.region}} · {{item.year}}</text>
      <text class="field-label">事实</text>
      <text class="item-text">{{item.facts}}</text>
      <text class="field-label">争点</text>
      <text class="item-text">{{item.focus}}</text>
      <text class="field-label">法律依据/说理</text>
      <text class="item-text">{{item.law}}</text>
      <text class="field-label">裁判结果</text>
      <text class="item-text">{{item.result}}</text>
      <text class="field-label">差异点</text>
      <text class="item-text">{{item.difference}}</text>
    </view>
    <view wx:if="{{!cases.length}}" class="empty">暂无可对比案例。</view>
  </view>
</view>
