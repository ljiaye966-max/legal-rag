# Production settings. Copy this file to .env on the Ubuntu server.
SECRET_KEY=replace-with-a-long-random-secret
DB_TYPE=sqlite
DATABASE_PATH=storage/legal_rag.db
CHROMA_PATH=storage/chroma
CHROMA_COLLECTION=legal_knowledge

# DashScope is optional. Keep false for a local RAG demonstration.
USE_LLM=false
CHAT_MODEL_NAME=qwen-plus
EMBEDDING_MODEL_NAME=text-embedding-v4
USE_DASHSCOPE_EMBEDDING=false
# DASHSCOPE_API_KEY=
DASHSCOPE_TIMEOUT=30

# Set to aliyun_sms_verify only after the Aliyun SMS verification service is configured.
SMS_PROVIDER=local
SMS_CODE_TTL_SECONDS=300
SMS_CODE_COOLDOWN_SECONDS=60
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_SMS_VERIFY_SIGN_NAME=
# ALIYUN_SMS_VERIFY_TEMPLATE_CODE=
ALIYUN_SMS_VERIFY_ENDPOINT=dypnsapi.aliyuncs.com
# ALIYUN_SMS_VERIFY_SCHEME_NAME=

TOP_K=6
KEYWORD_WEIGHT=0.35
VECTOR_WEIGHT=0.65
ASSISTANT_MIN_RELEVANCE_SCORE=0.24
